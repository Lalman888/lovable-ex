# Security
SECRET_KEY=your_secret_key_here # Replace with a strong, random secret key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MongoDB
MONGO_URI=mongodb://mongo:27017/mydatabase # Replace 'mydatabase' if needed

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_REQUEST=task_requests
KAFKA_TOPIC_STATUS=task_status

# Redis (Celery Broker/Backend)
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTIC_URL=http://elasticsearch:9200

# Prometheus (for multi-process Uvicorn workers)
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dir # Ensure this directory exists or is created in the FastAPI container
